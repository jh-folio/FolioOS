{
  "name": "folio-os-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Folio OS React island shell (gradual adoption). Builds fixed-name bundles into ../public/react for the FastAPI static server to serve.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "npm run test:source && npm run test:unit",
    "test:source": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
